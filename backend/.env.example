DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=phishshift_db
DB_USER=your_local_database_user
DB_PASSWORD=your_local_database_password
DB_ALLOW_EMPTY_PASSWORD=false

# Generate a random value with at least 32 bytes of entropy; never reuse DB credentials.
SESSION_SECRET=replace_with_a_random_secret_at_least_64_characters
AUTH_SESSION_TTL_SECONDS=28800
APP_ENV=development
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Comma-separated exact browser origins. Keep the local Vite origins for development.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
